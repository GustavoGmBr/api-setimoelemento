# Copie para .env e preencha. O .env NUNCA vai para o GitHub.
NODE_ENV=development
PORT=3335
HOST=127.0.0.1

# mysql://USUARIO:SENHA@HOST:3306/BANCO  (caracteres especiais da senha precisam de URL-encode, ex.: @ vira %40)
DATABASE_URL=

# Segredo do JWT: no minimo 32 caracteres, aleatorio.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=24h

# Origens permitidas no CORS, separadas por virgula (sem barra no final).
# Em desenvolvimento qualquer http://localhost:PORTA ja e aceito.
CORS_ORIGINS=https://setimoelemento.com.br,https://www.setimoelemento.com.br

# Hospedagem do site (FTP): as imagens enviadas pelo painel vao para <FTP_REMOTE_ROOT>/uploads/<pasta>/.
FTP_HOST=
FTP_USER=
FTP_PASSWORD=
# FTP_SECURE=false
# Pasta do site no FTP (veja o deploy.mjs do projeto antigo):
#  - usuario FTP principal (master) da conta cPanel: FTP_REMOTE_ROOT=/setimoelemento.com.br
#  - usuario FTP do dominio (ja entra dentro da pasta do site): deixe VAZIO -> FTP_REMOTE_ROOT=
# FTP_REMOTE_ROOT=   (se omitido, a API descobre sozinha olhando a raiz do FTP)
# UPLOAD_PUBLIC_URL=https://setimoelemento.com.br/uploads
